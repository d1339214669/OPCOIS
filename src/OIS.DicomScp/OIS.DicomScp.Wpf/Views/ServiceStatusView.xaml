<UserControl x:Class="OIS.DicomScp.Wpf.Views.ServiceStatusView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="监听端口：" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBlock Text="{Binding Port}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBlock Text="AET：" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBlock Text="{Binding AeTitle}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBlock Text="运行状态：" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBlock Text="{Binding IsRunning}" VerticalAlignment="Center" Margin="0,0,16,0" />
            <TextBlock Text="实例总数：" VerticalAlignment="Center" Margin="0,0,4,0" />
            <TextBlock Text="{Binding InstanceCountDisplay}" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <Button x:Name="BtnStart" Content="启动服务" Width="90" Margin="0,0,8,0" />
            <Button x:Name="BtnStop" Content="停止服务" Width="90" Margin="0,0,8,0" />
            <Button x:Name="BtnRefresh" Content="刷新" Width="70" />
        </StackPanel>

        <TextBlock Grid.Row="2"
                   Text="{Binding StatusText}"
                   Margin="0,0,0,8" />

        <TextBlock Grid.Row="3"
                   Text="{Binding ErrorText}"
                   Foreground="Red"
                   TextWrapping="Wrap" />
    </Grid>
</UserControl>
